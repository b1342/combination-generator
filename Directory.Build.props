<Project>
  <!-- הגדרות משותפות לכל הפרויקטים ב-Solution, כדי לא לחזור עליהן בכל csproj -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      אזהרות על חולשת אבטחה שתתגלה בעתיד באחת הספריות (NuGet audit) נשארות אזהרות ולא שוברות את הבנייה.
      אחרת, מי שיוריד את הקוד בעוד חודש עלול לקבל בנייה שנכשלת בלי ששינו בה שורה.
    -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
