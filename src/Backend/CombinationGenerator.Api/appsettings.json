{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "SessionStore": {
    "IdleTimeoutMinutes": 30,
    "MaxSessions": 1000,
    "CleanupIntervalSeconds": 60
  },

  "Generator": {
    "MaxPageSize": 200
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  }
}
